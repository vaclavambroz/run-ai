{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vaclavambroz/run-ai/schemas/run-ai-release-v1.json",
  "title": "run-ai signed release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "version",
    "channel",
    "source_commit",
    "source_date_epoch",
    "generated_at",
    "artifacts",
    "signing"
  ],
  "properties": {
    "schema": {"const": "run-ai-release/v1"},
    "project": {"const": "run-ai"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "channel": {"enum": ["stable", "candidate"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_date_epoch": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature_path"],
      "properties": {
        "algorithm": {"const": "minisign"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
        "signature_path": {"const": "manifest.json.minisig"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_toolchain", "host_os", "host_arch"],
      "properties": {
        "git_tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
        "go_toolchain": {"type": "string", "minLength": 1, "maxLength": 256},
        "host_os": {"type": "string", "pattern": "^[a-z0-9]+$"},
        "host_arch": {"type": "string", "pattern": "^[a-z0-9_]+$"}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "os", "arch", "size", "sha256", "sbom"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]+$"},
        "kind": {"enum": ["archive", "deb"]},
        "os": {"enum": ["linux", "darwin"]},
        "arch": {"enum": ["amd64", "arm64"]},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sbom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format", "sha256"],
          "properties": {
            "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]+$"},
            "format": {"const": "spdx-json-2.3"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
