{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vaclavambroz/run-ai/schemas/run-ai-platform-profile-v1.json",
  "title": "run-ai platform detection profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "description", "detector", "results", "automatic_mutation"],
  "properties": {
    "schema": {"const": "run-ai-platform-profile/v1"},
    "id": {"const": "wsl"},
    "description": {"type": "string", "minLength": 1},
    "detector": {"const": "/usr/lib/run-ai/detect-wsl"},
    "results": {
      "type": "array",
      "prefixItems": [
        {"const": "wsl1"},
        {"const": "wsl2"},
        {"const": "wsl"},
        {"const": "not-wsl"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "automatic_mutation": {"const": false}
  }
}
